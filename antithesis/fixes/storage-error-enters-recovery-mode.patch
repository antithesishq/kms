+    /// Private storage that holds what `inner` holds but cannot read it back, as S3 storage
+    /// behaves while the network to it is down. Every read fails, and with `fail_listing` every
+    /// listing and existence check fails too.
+    struct UnreadableStorage {
+        inner: RamStorage,
+        fail_listing: bool,
+    }
+
+    impl StorageReader for UnreadableStorage {
+        async fn data_exists(&self, data_id: &RequestId, data_type: &str) -> anyhow::Result<bool> {
+            if self.fail_listing {
+                anyhow::bail!("dispatch failure");
+            }
+            self.inner.data_exists(data_id, data_type).await
+        }
+
+        async fn read_data<T: DeserializeOwned + Unversionize + Named + Send>(
+            &self,
+            _data_id: &RequestId,
+            _data_type: &str,
+        ) -> anyhow::Result<T> {
+            anyhow::bail!("dispatch failure")
+        }
+
+        async fn load_bytes(
+            &self,
+            _data_id: &RequestId,
+            _data_type: &str,
+        ) -> anyhow::Result<Vec<u8>> {
+            anyhow::bail!("dispatch failure")
+        }
+
+        async fn all_data_ids(&self, data_type: &str) -> anyhow::Result<HashSet<RequestId>> {
+            if self.fail_listing {
+                anyhow::bail!("dispatch failure");
+            }
+            self.inner.all_data_ids(data_type).await
+        }
+
+        async fn all_data_types(&self) -> anyhow::Result<RootEntries> {
+            if self.fail_listing {
+                anyhow::bail!("dispatch failure");
+            }
+            self.inner.all_data_types().await
+        }
+
+        fn info(&self) -> String {
+            "UnreadableStorage".to_string()
+        }
+    }
+
+    /// A node whose signing key is in private storage but cannot be read at boot, because the
+    /// read of the key or the listing that finds it fails, has not lost its key. It must not boot
+    /// in recovery mode, where it would refuse to sign until restarted, even though public storage
+    /// holds a key to boot under. The boot fails, and once storage answers again the retried boot
+    /// runs under the node's signing key.
+    #[tokio::test]
+    async fn boot_base_kms_does_not_enter_recovery_mode_when_the_signing_key_is_unreadable() {
+        let mut rng = AesRng::seed_from_u64(0);
+        let seed = RootSigningSeed::random(&mut rng);
+        let sk = seed.derive_ecdsa_signing_key().unwrap();
+        let mut private_storage = RamStorage::new();
+        store_versioned_at_request_id(
+            &mut private_storage,
+            &SIGNING_KEY_ID,
+            &seed,
+            &PrivDataType::SigningSeed.to_string(),
+        )
+        .await
+        .unwrap();
+        store_versioned_at_request_id(
+            &mut private_storage,
+            &SIGNING_KEY_ID,
+            &sk,
+            &PrivDataType::SigningKey.to_string(),
+        )
+        .await
+        .unwrap();
+        let verf_key = PublicSigKey::from_sk(&sk);
+        let mut public_storage = RamStorage::new();
+        store_versioned_at_request_id(
+            &mut public_storage,
+            &SIGNING_KEY_ID,
+            &verf_key,
+            &PubDataType::VerfKey.to_string(),
+        )
+        .await
+        .unwrap();
+
+        for fail_listing in [false, true] {
+            let unreadable = UnreadableStorage {
+                inner: private_storage.clone(),
+                fail_listing,
+            };
+            assert!(
+                boot_base_kms(
+                    KMSType::Threshold,
+                    &unreadable,
+                    &public_storage,
+                    None,
+                    test_rng_source(),
+                )
+                .await
+                .is_err(),
+                "a node whose signing key could not be read must not boot in recovery mode \
+                 (listing fails: {fail_listing})"
+            );
+        }
+
+        let base_kms = boot_base_kms(
+            KMSType::Threshold,
+            &private_storage,
+            &public_storage,
+            None,
+            test_rng_source(),
+        )
+        .await
+        .unwrap();
+        let identity = base_kms
+            .signing_identity()
+            .expect("once storage answers, the node must boot under its signing key");
+        assert_eq!(identity.verf_key(), verf_key);
+    }
