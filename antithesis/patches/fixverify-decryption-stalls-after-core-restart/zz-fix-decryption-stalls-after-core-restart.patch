diff --git a/core/threshold-networking/src/constants.rs b/core/threshold-networking/src/constants.rs
index ee2ea53..826bb97 100644
--- a/core/threshold-networking/src/constants.rs
+++ b/core/threshold-networking/src/constants.rs
@@ -32,6 +32,20 @@ pub const MAX_INTERVAL: Duration = Duration::from_secs(60);
 /// The default maximum elapsed time before giving up on retrying
 pub(crate) const MAX_ELAPSED_TIME: Duration = Duration::from_secs(60);
 
+/// Interval between the HTTP/2 PINGs sent on a core-to-core channel, also while it is idle.
+/// A peer that disappears without closing its connections (a killed pod, or a close lost to a
+/// network fault) is otherwise never noticed, and every later message is written into the dead
+/// connection until the kernel gives up on it.
+pub(crate) const CORE_TO_CORE_KEEP_ALIVE_INTERVAL: Duration = Duration::from_secs(10);
+
+/// Time to wait for the acknowledgement of a PING before the connection is closed, which fails
+/// the pending sends (so they are retried) and makes the channel reconnect.
+pub(crate) const CORE_TO_CORE_KEEP_ALIVE_TIMEOUT: Duration = Duration::from_secs(20);
+
+/// Maximum time to establish a core-to-core connection (TCP and TLS handshakes), which the
+/// keep-alive does not cover.
+pub(crate) const CORE_TO_CORE_CONNECT_TIMEOUT: Duration = Duration::from_secs(30);
+
 /// maximum number of seconds that a party waits for a network message during a protocol
 pub(crate) const NETWORK_TIMEOUT: Duration = Duration::from_secs(5);
 
